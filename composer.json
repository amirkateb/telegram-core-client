{
    "name": "amirkateb/telegram-core-client",
    "description": "Official Laravel client SDK for Telegram Core",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "telegram",
        "telegram-bot",
        "sdk",
        "tgcore"
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "KatebSaber\\TelegramCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KatebSaber\\TelegramCore\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KatebSaber\\TelegramCore\\TelegramCoreServiceProvider"
            ],
            "aliases": {
                "TelegramCore": "KatebSaber\\TelegramCore\\Facades\\TelegramCore"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
